{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.midnightoil.app"
        }
      ],
      "destination": "https://midnightoil.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.midnightoil.app"
        }
      ],
      "destination": "https://midnightoil.app/:path*",
      "permanent": true
    },
    {
      "source": "/agents",
      "destination": "/cli",
      "permanent": true
    }
  ]
}
